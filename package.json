{
  "name": "repo-template",
  "version": "1.0.0",
  "description": "Minimal vanilla JS + Babel + webpack template with ESLint, Prettier, dev server, and GitHub Pages deploy.",
  "private": true,
  "scripts": {
    "start": "webpack serve --config webpack.dev.js --open",
    "dev": "webpack serve --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "preview": "npm run build && npx serve dist",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predeploy": "npm run clean && npm run build",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "webpack",
    "template",
    "vanilla-js",
    "babel",
    "eslint",
    "prettier"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
